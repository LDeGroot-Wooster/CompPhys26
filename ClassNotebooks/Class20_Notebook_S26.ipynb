   "source": [
    "kBT = 10\n",
    "m = 1\n",
    "hbar = 1\n",
    "L = 10\n",
    "N = 1000\n",
    "num_steps = 10000000\n",
    "nx = ny = nz = 1\n",
    "\n",
    "n_arr = np.ones([N, 3], int) #stores nx ny nz (starts with ones)\n",
    "E_list = [] #stores Energies\n",
    "\n",
    "#calculate starting E\n",
    "E = (np.pi**2*hbar**2/(2*m*L**2))*(nx**2+ny**2+nz**2)\n",
    "\n",
    "#MCMC loop\n",
    "for i in range(num_steps):\n",
    "    #choose random particle\n",
    "    j = random.randrange(N)\n",
    "    #choose random quantum number (nx, ny, nz)\n",
    "    k = random.randrange(3)\n",
    "    #choose +1 or -1 move\n",
    "    if random.random() > 0.5:\n",
    "        dn = 1\n",
    "        dE = (np.pi**2*hbar**2/(2*m*L**2))*(2*n_arr[j,k]+1)\n",
    "    else:\n",
    "        dn = -1\n",
    "        dE = (np.pi**2*hbar**2/(2*m*L**2))*(-2*n_arr[j,k]+1)\n",
    "    #don't allow (nx, ny, nz) to go below 1\n",
    "    if n_arr[j,k]>1 or dn==1:\n",
    "        #apply metropolis algortithm\n",
    "        if random.random() < np.exp(-dE/kBT): #implement acceptance probability\n",
    "            n_arr[j,k] += dn\n",
    "            E += dE\n",
    "    E_list.append(E)\n",
    "\n",
    "plt.plot(E_list)\n",
    "plt.show()"
   ]
